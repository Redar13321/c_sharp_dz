<Window x:Name="window" x:Class="WpfApp4.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:WpfApp4"
		mc:Ignorable="d"
		Icon="icon.png"
		Background="#FFFDFAF1"
		Title="Список Дел" Height="400" Width="450">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="HeadersVisibility" Value="None"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="Background" Value="#FFFDF5DF"/>
            <Setter Property="TextBlock.Background" Value="white"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#5EBEC4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список дел" FontSize="26" Margin="10, 10, 10, 10" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource HeaderStyle}"/>

        <DataGrid Name="ListBoxToDo"  Grid.Row="1" Margin="10,0,10,10" Grid.ColumnSpan="2" >
            <DataGrid.Columns>
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Done}" Click="onSetToDoIsDone"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="1*" Binding="{Binding Path=Name}" IsReadOnly="True" />
                <DataGridTextColumn Width="1*" Binding="{Binding Path=Date, StringFormat=dd.MM.yyyy}" IsReadOnly="True" />
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="ButtonDelete_Clicked" Background="#5EBEC4">
                                <Image Source="delete.png" Width="10" Height="10"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Path=Description}" FontSize="10"/>
                    </StackPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
        <Button Name="ButtonNewToDo" Click="ButtonNewToDo_Clicked" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10, 10, 10, 10" Height="40" Width="60" Grid.Row="0">
            <Image Source="add.png" Width="25" Height="25"/>
        </Button>

        <ProgressBar Name="progBarToDO" Grid.Row="2" Minimum="0" Maximum="10" Value="5" Margin="5" />
        <TextBlock Name="textBarToDO" FontSize="14" Grid.Row="2" Text="1/2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
