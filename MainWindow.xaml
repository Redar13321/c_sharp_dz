<Window x:Name="window" x:Class="WpfApp4.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:WpfApp4"
		mc:Ignorable="d"
		Icon="icon.png"
		Background="#FFFDFAF1"
		Title="Список Дел" Height="400" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список дел" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <DataGrid Name="ListBoxToDo"  Grid.Row="1" HeadersVisibility="None" AutoGenerateColumns="False" Margin="10,0,10,10" Grid.ColumnSpan="2" Background="#FFFDF5DF" GridLinesVisibility="Horizontal" >
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding Path=Doing}"/>
                <DataGridTextColumn Width="1*" Binding="{Binding Path=Name}" IsReadOnly="True" />
                <DataGridTextColumn Width="1*" Binding="{Binding Path=Date, StringFormat=dd.MM.yyyy}" IsReadOnly="True" />
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="ButtonDelete_Clicked" Background="#5EBEC4">
                                <Image Source="delete.png" Width="10" Height="10"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Path=Description}" FontSize="10"/>
                    </StackPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
        <Button Name="ButtonNewToDo" Click="ButtonNewToDo_Clicked" Content="Добавить дело" HorizontalAlignment="Center" VerticalAlignment="Center" Height="40" Width="180" Background="#5EBEC4" Grid.Row="2"/>
    </Grid>
</Window>
