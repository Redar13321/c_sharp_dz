<Window x:Class="WpfApp9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp9"
        mc:Ignorable="d"
        Background="#FFFDFAF1"
        Title="Список дел" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <TextBlock Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26"> Список дел </TextBlock>

        <ListBox Grid.Row="1" Margin="10,10,10,10" Background="#FDF5DF" TextBlock.FontSize="14">
            <ListBoxItem>
                <StackPanel>
                    <TextBlock>Приготовить покушать</TextBlock>
                    <TextBlock>15.01.2024</TextBlock>
                    <TextBlock FontSize="10">Нет описания</TextBlock>
                </StackPanel>
            </ListBoxItem>
            
            <ListBoxItem>
                <StackPanel>
                    <TextBlock>Поработать</TextBlock>
                    <TextBlock>20.01.2024</TextBlock>
                    <TextBlock FontSize="10">Съездить на совещание в Москву</TextBlock>
                </StackPanel>
            </ListBoxItem>
            
            <ListBoxItem>
                <StackPanel>
                    <TextBlock>Отдохнуть</TextBlock>
                    <TextBlock>01.02.2024</TextBlock>
                    <TextBlock FontSize="10">Съездить в отпуск в Сочи</TextBlock>
                </StackPanel>
            </ListBoxItem>
        </ListBox>
        <Button Background="#5EBEC4" Grid.Row="2" MaxWidth="100" MaxHeight="30" Margin="10, 10, 10, 10">
            Удалить дела
        </Button>
    </Grid>
</Window>
