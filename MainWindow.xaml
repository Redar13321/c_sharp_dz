<Window x:Class="WpfApp8.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:WpfApp8"
		mc:Ignorable="d"
		WindowState="Maximized"
		Title="MainWindow" Height="450" Width="1300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>


        <WrapPanel x:Name="wrapPanel">
            <Viewbox>
                <TextBlock Text="Наши лучшие работы" FontFamily="Impact" FontSize="20" Foreground="DarkGray" TextAlignment="Center" Margin="10, 10, 10, 10"/>
            </Viewbox>

            <ListBox FontSize="16" FontFamily="Impact" BorderThickness="0,0,0,0" HorizontalContentAlignment="Center" Padding="10,0,0,0" Width="{Binding ActualWidth, ElementName=wrapPanel, Mode=OneWay}" ScrollViewer.CanContentScroll="True">

                <StackPanel>
                    <Image Source="/Me-after-I-fail-my-math-quiz.jpg" MaxHeight="150"/>
                    <TextBlock TextAlignment="Center">Антон</TextBlock>
                </StackPanel>

                <StackPanel>
                    <Image Source="/Silly Cats Pictures.jfif" MaxHeight="150"/>
                    <TextBlock TextAlignment="Center">Не Антон</TextBlock>
                </StackPanel>

                <StackPanel>
                    <Image Source="/Me-after-I-fail-my-math-quiz.jpg" MaxHeight="150"/>
                    <TextBlock TextAlignment="Center">Антонов</TextBlock>
                </StackPanel>

                <StackPanel>
                    <Image Source="/Me-after-I-fail-my-math-quiz.jpg" MaxHeight="150"/>
                    <TextBlock TextAlignment="Center">Антон</TextBlock>
                </StackPanel>

                <StackPanel>
                    <Image Source="/Silly Cats Pictures.jfif" MaxHeight="150"/>
                    <TextBlock TextAlignment="Center">Антонов</TextBlock>
                </StackPanel>

                <StackPanel>
                    <Image Source="/Me-after-I-fail-my-math-quiz.jpg" MaxHeight="150"/>
                    <TextBlock TextAlignment="Center">Не Антон</TextBlock>
                </StackPanel>
            </ListBox>
        </WrapPanel>

        <StackPanel Grid.Column="1">
            <TabControl Margin="10, 10, 10, 10">
                <TabItem Header="Инструменты" IsSelected="True">
                    <StackPanel>
                        <Menu VerticalAlignment="Top">
                            <MenuItem Header="Файл">
                                <MenuItem Header="Новый"></MenuItem>
                                <MenuItem Header="Открыть"></MenuItem>
                            </MenuItem>
                            <MenuItem Header="Редактировать">
                                <MenuItem Header="Обрезать">
                                    <MenuItem Header="Обрезать квадрат"/>
                                    <MenuItem Header="Произвольная обрезка"/>
                                </MenuItem>
                                <MenuItem Header="Изменить цвет"></MenuItem>
                            </MenuItem>
                        </Menu>
                        <StackPanel Margin="10,10,10,10">
                            <TextBlock TextBlock.FontSize="20" FontFamily="Impact">Услуги</TextBlock>
                            <ListBox TextBlock.FontSize="16">
                                <ListBoxItem>Фотография</ListBoxItem>
                                <ListBoxItem>Ретуширование</ListBoxItem>
                                <ListBoxItem>Исправоение недостатков</ListBoxItem>
                                <ListBoxItem>Изменение фона</ListBoxItem>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Редактировать"></MenuItem>
                                        <MenuItem Header="Удалить"></MenuItem>
                                        <MenuItem Header="Создать на основе"></MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Расписание">

                </TabItem>
            </TabControl>
        </StackPanel>

        <Viewbox Grid.Column="2" VerticalAlignment="Top">
            <Calendar DisplayDateStart="2022-11-21" DisplayDate="2022-11-23"/>
        </Viewbox>
    </Grid>
</Window>
