<Window x:Class="WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="10">

        <GroupBox Header="CPU-bound операция" Margin="0,5">
            <StackPanel>
                <ProgressBar x:Name="cpuProgress" Height="20" Margin="0,5"/>
                <TextBlock x:Name="cpuResult" Text="Результат: Ожидание вычисления" Margin="0,5"/>
                <Button x:Name="btnCalculate" Content="Вычислить сумму" 
                        Click="btnCalculate_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="HTTP запрос" Margin="0,5">
            <StackPanel>
                <TextBlock x:Name="httpResult" Text="Данные: Ожидание загрузки" 
                           TextWrapping="Wrap" Margin="0,5"/>
                <Button x:Name="btnLoadData" Content="Загрузить данные" 
                        Click="btnLoadData_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Блокирующая операция" Margin="0,5">
            <StackPanel>
                <TextBlock x:Name="blockingStatus" Text="Статус: Готов" Margin="0,5"/>
                <Button x:Name="btnBlocking" Content="Запустить блокирующую операцию" 
                        Click="btnBlocking_Click"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Margin="0,5">
            <Button x:Name="btnClear" Content="Очистить все" 
                    Click="btnClear_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
