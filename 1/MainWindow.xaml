<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Доступно разрешений:" Margin="0,0,5,0"/>
            <TextBlock x:Name="semaphoreStatus" Text="3/3" FontWeight="Bold" Margin="0,0,20,0"/>
            <TextBlock Text="Ожидающих задач:" Margin="0,0,5,0"/>
            <TextBlock x:Name="waitingTasks" Text="0" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Height="40">
            <Button x:Name="btnStartTasks" Content="Запустить 5 задач записи" 
                    Click="btnStartTasks_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnClearFile" Content="Очистить файл (WriterLock)" 
                    Click="btnClearFile_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnShowFile" Content="Показать содержимое файла" 
                    Click="btnShowFile_Click"/>
        </StackPanel>

        <GroupBox Header="Логи операций" Margin="0,10" Height="300">
            <ListBox x:Name="logListBox"/>
        </GroupBox>
    </StackPanel>
</Window>
