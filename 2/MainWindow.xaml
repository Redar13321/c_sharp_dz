<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <StackPanel Margin="10">
            <GroupBox Header="Потоки с разными приоритетами" Margin="0,5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Lowest: " Width="80" FontWeight="Bold"/>
                        <TextBlock x:Name="txtLowest" Text="0" Background="#FFE6E6"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Normal: " Width="80" FontWeight="Bold"/>
                        <TextBlock x:Name="txtNormal" Text="0" Background="#E6F3FF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Highest: " Width="80" FontWeight="Bold"/>
                        <TextBlock x:Name="txtHighest" Text="0" Background="#E6FFE6"/>
                    </StackPanel>

                    <Button x:Name="btnStartThreads" Content="Запустить все потоки" 
                                    Click="btnStartThreads_Click" Margin="0,5"/>
                    <Button x:Name="btnReset" Content="Сбросить" 
                                    Click="btnReset_Click" Margin="0,5"/>

                    <TextBlock x:Name="completionStatus" Text="Статус: Ожидание запуска" Margin="0,5"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </StackPanel>
</Window>
